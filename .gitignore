**/nbproject/private/
**/nbproject/Makefile-*.mk
**/nbproject/Package-*.bash
build/
nbbuild/
dist/
nbdist/
.nb-gradle/

# Optional: Uncomment if developers use different local Payara domains or run actions
# nb-configuration.xml
# nbactions.xml

# ==========================================
# Maven / Gradle Build Outputs (if applicable)
# ==========================================
target/
.gradle/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties

# ==========================================
# Java & Java EE / Jakarta EE Packages
# ==========================================
*.class
*.jar
*.war
*.ear
*.nar
hs_err_pid*
replay_pid*

# ==========================================
# Payara / GlassFish Local Artifacts & Logs
# ==========================================
*.log
glassfish/domains/
payara/domains/
**/generated/

# ==========================================
# OS & Temporary Files
# ==========================================
.DS_Store
Thumbs.db
*~
*.swp
*.bak
*.tmp
# ==========================================
# Úppa: dependencias versionadas a propósito
# ==========================================
# PrimeFaces se distribuye con el proyecto para que compile en otro equipo sin rutas absolutas
!EnterpriseApplication2-war/lib/*.jar

# Servicio Python
uppa-api/.venv/
uppa-api/__pycache__/
uppa-api/**/__pycache__/
